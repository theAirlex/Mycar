"short EngineStep component description"
component EngineStep
  engine = mycar.Engine() {^engine}
  cmd = BlockComponents.Sources.Step(height = 200, start_time = 0.5, offset = 0) {^cmd}
  load = RotationalComponents.Components.Inertia(J = 1, phi = initial 0, w = initial 0) {^load}
  mounts = RotationalComponents.Components.Fixed() {^mounts}
relations
  connect(cmd.y, engine.tau_cmd) {^id5}
  connect(load.spline_a, engine.spline) {^id6}
  connect(mounts.spline, engine.spline1) {^id7}
