"short Engine component description"
component Engine
  limiter = BlockComponents.Nonlinear.Limiter(y_max = T_max, y_min = 0) {^limiter}
  spline = Dyad.Spline() {^spline}
  spline1 = Dyad.Spline() {^spline1}
  torquesource = RotationalComponents.Sources.TorqueSource() {^torquesource}
  lag = BlockComponents.Continuous.FirstOrder(T = tau_e) {^lag}
  dealy = BlockComponents.Nonlinear.PadeDelay(n = 6, m = 5, delayTime = theta_e) {^dealy}
  tau_cmd = Dyad.RealInput() {^tau_cmd}
  "Injection-to-torque transport delay"
  structural parameter theta_e::Time = 0.3
  "Manifold-filling first-order lag"
  parameter tau_e::Time = 0.3
  "Peak deliverable torque"
  parameter T_max::Torque = 150
relations
  connect(dealy.y, lag.u) {^id8}
  connect(lag.y, limiter.u) {^id9}
  connect(limiter.y, torquesource.tau) {^id10}
  connect(torquesource.support, spline1) {^id11}
  connect(torquesource.spline, spline) {^id12}
  connect(dealy.u, tau_cmd) {^id13}
metadata {
